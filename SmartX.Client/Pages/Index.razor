@page "/"
@inject NavigationManager Nav
@inject ApiService Api

<PageTitle>Smart-X | Home</PageTitle>

@if (!_isLoggedIn)
{
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="card shadow-lg p-5" style="width: 400px;">
            <h2 class="text-center mb-4">Smart-X Login</h2>
            <input class="form-control mb-3" placeholder="Email" @bind="_email" />
            <input class="form-control mb-4" type="password" placeholder="Password (min 4 chars)" @bind="_password" />
            <button class="btn btn-primary w-100" @onclick="HandleLogin">Secure Login</button>
            @if (_error)
            {
                <p class="text-danger mt-2">Invalid credentials</p>
            }
        </div>
    </div>
}
else
{
    <div class="container py-5">
        <h1 class="text-center mb-5">Smart-X Gateway</h1>
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 pillar-card" @onclick="GoToDashboard">
                    <div class="card-body text-center p-4">
                        <div class="pillar-icon">📡</div><h4 class="mt-3">Data Ingestion</h4>
                        <span class="badge bg-success">Active</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 pillar-card" @onclick="GoToCommandStream">
                    <div class="card-body text-center p-4">
                        <div class="pillar-icon">⚡</div><h4 class="mt-3">Command Stream</h4>
                        <span class="badge bg-success">Active</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 pillar-card disabled-pillar">
                    <div class="card-body text-center p-4">
                        <div class="pillar-icon">🌐</div><h4 class="mt-3">Network Topology</h4>
                        <span class="badge bg-secondary">Coming Soon</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoggedIn = false;
    private string _email = ""; private string _password = ""; private bool _error = false;

    private async Task HandleLogin()
    {
        var success = await Api.LoginAsync(_email, _password);
        if (success) _isLoggedIn = true;
        else _error = true;
    }

    private void GoToDashboard() => Nav.NavigateTo("/dashboard");
    private void GoToCommandStream() => Nav.NavigateTo("/command-stream");
}