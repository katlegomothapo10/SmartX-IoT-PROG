@page "/"
@inject NavigationManager Nav
@inject ApiService Api

<PageTitle>Smart-X | Login</PageTitle>

@if (!_isLoggedIn)
{
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="card shadow-lg p-5 border-0" style="width: 400px; border-radius: 15px;">
            <h2 class="text-center mb-4 text-primary fw-bold">Smart-X Login</h2>
            <p class="text-muted text-center small mb-4">Secure IoT Mesh Authentication</p>
            <input class="form-control mb-3" placeholder="Email" @bind="_email" />
            <input class="form-control mb-4" type="password" placeholder="Password (min 4 chars)" @bind="_password" />
            <button class="btn btn-primary w-100 fw-bold" @onclick="HandleLogin">Secure Login</button>
            @if (_error)
            {
                <p class="text-danger mt-3 text-center small">Invalid credentials. Use password 1234.</p>
            }
        </div>
    </div>
}
else
{
    <div class="container py-5">
        <div class="text-center mb-5">
            <h1 class="display-4 fw-bold text-primary">Smart-X IoT Enterprise</h1>
            <p class="lead text-muted">Real-time mesh monitoring and device management.</p>
            <hr class="w-50 mx-auto" />
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="card h-100 shadow border-0" @onclick="GoToDashboard" style="cursor: pointer;">
                    <div class="card-body text-center p-4">
                        <div class="pillar-icon" style="font-size: 3rem;">📡</div>
                        <h4 class="mt-3">Data Ingestion</h4>
                        <span class="badge bg-success">Active</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow border-0" @onclick="GoToCommandStream" style="cursor: pointer;">
                    <div class="card-body text-center p-4">
                        <div class="pillar-icon" style="font-size: 3rem;">⚡</div>
                        <h4 class="mt-3">Command Stream</h4>
                        <span class="badge bg-success">Active</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow border-0 bg-light" style="opacity: 0.7; cursor: not-allowed;">
                    <div class="card-body text-center p-4">
                        <div class="pillar-icon" style="font-size: 3rem;">🌐</div>
                        <h4 class="mt-3">Network Topology</h4>
                        <span class="badge bg-secondary">Coming Soon</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoggedIn = false;
    private string _email = "";
    private string _password = "";
    private bool _error = false;

    private async Task HandleLogin()
    {
        var success = await Api.LoginAsync(_email, _password);
        if (success) _isLoggedIn = true;
        else _error = true;
    }

    private void GoToDashboard() => Nav.NavigateTo("/dashboard");
    private void GoToCommandStream() => Nav.NavigateTo("/command-stream");
}