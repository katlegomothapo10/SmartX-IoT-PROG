@page "/register"
@inject ApiService Api
@inject NavigationManager Nav
@using SmartX.Client.Models
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Smart-X | Register Sensor</PageTitle>

<div class="container py-4" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Register New Sensor</h2>
            <small class="text-muted">Add a device to the Smart-X mesh</small>
        </div>
        <button class="btn btn-outline-secondary" @onclick="GoBack">← Back</button>
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success">@_successMessage</div>
    }
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    <EditForm Model="_sensor" OnValidSubmit="Submit">
        <DataAnnotationsValidator />

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-primary text-white">
                <strong>Sensor Details</strong>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">MAC Address / Unique ID <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="_sensor.MacAddress"
                               placeholder="AA:BB:CC:DD:EE:FF" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Deployment Location <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="_sensor.DeploymentLocation"
                               placeholder="e.g. Hydro Bay 1 / Tray A" />
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Category</label>
                        <InputSelect class="form-select" @bind-Value="_sensor.Category">
                            @foreach (var cat in Enum.GetValues<SensorType>())
                            {
                                <option value="@cat">@cat</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Zone ID</label>
                        <InputText class="form-control" @bind-Value="_sensor.ZoneId"
                                   placeholder="zone-1" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Facility ID</label>
                        <InputText class="form-control" @bind-Value="_sensor.FacilityId"
                                   placeholder="facility-a" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" @bind-Value="_sensor.Description"
                                   rows="2" placeholder="Optional description" />
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-secondary text-white">
                <strong>Configuration File (Optional)</strong>
            </div>
            <div class="card-body">
                <InputFile OnChange="OnFileSelected" class="form-control" />
                @if (_selectedFileName != null)
                {
                    <small class="text-muted d-block mt-2">Selected: @_selectedFileName</small>
                }
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1" disabled="@_submitting">
                @(_submitting ? "Registering..." : "Register Sensor")
            </button>
        </div>
    </EditForm>
</div>

@code {
    private Sensor _sensor = new();
    private IBrowserFile? _selectedFile;
    private string? _selectedFileName;
    private string? _successMessage;
    private string? _errorMessage;
    private bool _submitting = false;
    private string? _fileTextContent;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _selectedFileName = e.File?.Name;
        if (_selectedFile != null && _selectedFile.Name.EndsWith(".txt")) {
            using var reader = new StreamReader(_selectedFile.OpenReadStream(10000000));
            _fileTextContent = await reader.ReadToEndAsync();
        }
    }

    private async Task Submit()
    {
        _submitting = true;
        _errorMessage = null;
        try {
            if (_fileTextContent != null) {
                var lines = _fileTextContent.Split('\n', StringSplitOptions.RemoveEmptyEntries);
                int count = 0;
                foreach (var line in lines) {
                    var mac = line.Trim();
                    if (string.IsNullOrEmpty(mac)) continue;
                    var bulkSensor = new Sensor { MacAddress = mac, DeploymentLocation = "Auto-loaded", Category = SensorType.Environmental, ZoneId = "auto", FacilityId = "a", Description = "Imported" };
                    await Api.RegisterSensorAsync(bulkSensor);
                    count++;
                }
                _successMessage = $"Imported {count} devices!";
                await Task.Delay(2000);
                Nav.NavigateTo("/dashboard");
                return;
            }

            var registered = await Api.RegisterSensorAsync(_sensor);
            if (!registered) { _errorMessage = "Failed. MAC exists."; _submitting = false; return; }
            _successMessage = $"Sensor {_sensor.MacAddress} registered!";
            await Task.Delay(1500);
            Nav.NavigateTo("/dashboard");
        } catch (Exception ex) { _errorMessage = ex.Message; }
        _submitting = false;
    }
    private void GoBack() => Nav.NavigateTo("/dashboard");
}
}