@page "/network-topology"
@inject ApiService Api
@inject NavigationManager Nav
@using SmartX.Client.Models

<PageTitle>Smart-X | Network Topology</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between mb-3 align-items-center">
        <div>
            <h2 class="fw-bold text-primary">🌐 Network Topology & Mesh Routing</h2>
            <p class="text-muted small mb-0">Graph traversals, Minimum Spanning Trees, and Binary Search Tree queries.</p>
        </div>
        <a href="/" class="btn btn-outline-secondary">← Back to Menu</a>
    </div>

    <div class="row">
        <div class="col-md-5">
            <div class="card shadow-sm mb-3 border-0 border-top border-primary border-4">
                <div class="card-header bg-white fw-bold">Mesh Graph Simulator</div>
                <div class="card-body">
                    <p class="small text-muted">Generate connections between your seeded sensors to test graph traversals.</p>
                    <button class="btn btn-primary w-100 mb-2" @onclick="SimulateMesh">🔗 Generate Mesh Connections</button>

                    @if (_meshGenerated)
                    {
                        <div class="alert alert-success py-1 text-center mb-3">✅ Mesh generated successfully!</div>
                    }
                    @if (!string.IsNullOrEmpty(_meshError))
                    {
                        <div class="alert alert-danger py-1 text-center mb-3">❌ @_meshError</div>
                    }

                    <hr />

                    <label class="fw-bold mb-2">Prim's Algorithm (MST)</label>
                    <div class="input-group mb-2">
                        <input class="form-control" placeholder="Start MAC (e.g. AA:BB...)" @bind="_startMac" />
                        <button class="btn btn-success" @onclick="RunMst">Calculate MST</button>
                    </div>
                    @if (_mstResult != null)
                    {
                        <div class="alert alert-success mt-3">
                            <strong>Minimum Spanning Tree (MST)</strong>
                            <ul class="mb-0 mt-2">
                                @foreach (var edge in _mstResult.MinimumSpanningTree)
                                {
                                    <li>To: @edge.TargetMac (Weight: @edge.Weight)</li>
                                }
                            </ul>
                        </div>
                    }

                    <hr />

                    <label class="fw-bold mb-2">BFS Traversal</label>
                    <div class="input-group mb-2">
                        <input class="form-control" placeholder="Start MAC" @bind="_bfsMac" />
                        <button class="btn btn-info text-white" @onclick="RunBfs">Run BFS</button>
                    </div>
                    @if (_bfsResult != null)
                    {
                        <div class="alert alert-info mt-3">
                            <strong>Connected Nodes (BFS)</strong>
                            <ul class="mb-0 mt-2">
                                @foreach (var node in _bfsResult.AllConnectedNodes)
                                {
                                    <li>@node</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm border-0 border-top border-warning border-4">
                <div class="card-header bg-white fw-bold text-warning">Historical Telemetry (Binary Search Tree)</div>
                <div class="card-body">
                    <p class="small text-muted">Query historical telemetry using a Binary Search Tree for O(log n) retrieval.</p>

                    <div class="row g-2 mb-3 align-items-end">
                        <div class="col-md-4">
                            <label class="small fw-bold">Start Time</label>
                            <input type="datetime-local" class="form-control" @bind="_startTime" />
                        </div>
                        <div class="col-md-4">
                            <label class="small fw-bold">End Time</label>
                            <input type="datetime-local" class="form-control" @bind="_endTime" />
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-warning w-100 text-dark fw-bold" @onclick="RunRangeQuery">Query Tree</button>
                        </div>
                    </div>

                    @if (_queryResult != null)
                    {
                        <p class="fw-bold mb-2">Found @_queryResult.Count readings:</p>
                        <div style="max-height: 400px; overflow-y: auto;">
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr><th>Timestamp</th><th>Device MAC</th><th>Type</th><th>Value</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in _queryResult.Data)
                                    {
                                        <tr>
                                            <td>@record.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                                            <td>@record.DeviceMac</td>
                                            <td>@record.SensorType</td>
                                            <td>@record.Value</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _startMac = "AA:BB:CC:DD:EE:01";
    private string _bfsMac = "AA:BB:CC:DD:EE:01";
    private bool _meshGenerated = false;
    private string? _meshError;

    private MstResponse? _mstResult;
    private BfsResponse? _bfsResult;
    private RangeQueryResponse? _queryResult;

    // Default to today (Local time on the browser)
    private DateTime _startTime = DateTime.Today;
    private DateTime _endTime = DateTime.Today.AddDays(1);

    private async Task SimulateMesh()
    {
        try
        {
            _meshError = null;
            await Api.SimulateMeshAsync();
            _meshGenerated = true;
        }
        catch (Exception ex)
        {
            _meshError = "Failed to connect to API. Are you logged in?";
        }
    }

    private async Task RunMst()
    {
        if (string.IsNullOrEmpty(_startMac)) return;
        _mstResult = await Api.GetMstAsync(_startMac);
        _bfsResult = null;
    }

    private async Task RunBfs()
    {
        if (string.IsNullOrEmpty(_bfsMac)) return;
        _bfsResult = await Api.GetBfsAsync(_bfsMac);
        _mstResult = null;
    }

    private async Task RunRangeQuery()
    {
        // FIX: Convert Local Browser Time to UTC for the backend BST
        var utcStart = _startTime.ToUniversalTime();
        var utcEnd = _endTime.ToUniversalTime();

        _queryResult = await Api.GetRangeQueryAsync(utcStart, utcEnd);
    }
}